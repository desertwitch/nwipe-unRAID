<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "dwnwipe">
<!ENTITY author    "desertwitch">
<!ENTITY version   "2026.08.22">
<!ENTITY gitURL    "https://raw.githubusercontent.com/&author;/nwipe-unRAID/main">
<!ENTITY pluginURL "&gitURL;/plugin/&name;.plg">
<!ENTITY pkgURL    "&gitURL;/packages">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="https://forums.unraid.net/topic/168624-plugin-nwipe-secure-disk-eraser-for-unraid/" min="6.10" icon="bomb">

<CHANGES>
## nwipe (Secure Disk Eraser) with Preclear
###2026.08.22
- new: ATA/NVMe Secure Erase (Hardware-native Sanitize)
- new: updated from nwipe-0.41 to nwipe-0.42
- changes: https://github.com/martijnvanbrummelen/nwipe/releases/tag/v0.42
###2026.08.18
- fix: do not remove libparted on uninstall (now part of OS)
###2026.05.17
- new: updated from nwipe-0.39 to nwipe-0.41
- changes: https://github.com/martijnvanbrummelen/nwipe/releases/tag/v0.41
- release note: for new disks, check out the new "scattered" I/O mode
- release note: ensures mechanical exercise, random seeks and long jumps
- release note: to find and use it, press key "d" when on disk selection screen
###2025.11.14
- new: added a custom "Unraid Preclear" method to nwipe-0.39 (now forked)
- release note: while this was extensively tested, please report back
- release note: successes or fails in the forum support topic, thanks!
- release note: use the Docker container to preclear disks on non-Unraid systems
- release note: https://github.com/desertwitch/nwipe-pc/pkgs/container/nwipe-pc
###2025.10.23
- new: updated from nwipe-0.38 to nwipe-0.39
###2025.01.12
- new: updated from nwipe-0.37 to nwipe-0.38
###2024.06.21
- release note: welcome to the first version of the package.
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
killall nwipe-bin >/dev/null 2>&amp;1
exit 0
</INLINE>
</FILE>

<!-- dependency packages -->
<FILE Name="&plgPATH;/parted-3.6-x86_64-1_slack15.1.txz" Min="6.13" Max="7.0.99" Run="upgradepkg --install-new">
<URL>&pkgURL;/parted-3.6-x86_64-1_slack15.1.txz</URL>
<MD5>a0d226c87c2bbfda2100030f30bd38ef</MD5>
</FILE>

<FILE Name="&plgPATH;/parted-3.4-x86_64-2_slack15.0.txz" Min="6.10" Max="6.12.99" Run="upgradepkg --install-new">
<URL>&pkgURL;/parted-3.4-x86_64-2_slack15.0.txz</URL>
<MD5>6df9026349b56b4e4beea086bc2afeb0</MD5>
</FILE>

<!-- plugin package -->
<FILE Name="&plgPATH;/nwipe-0.42-x86_64-1_unraid.txz" Min="6.10" Run="upgradepkg --install-new">
<URL>&pkgURL;/nwipe-0.42-x86_64-1_unraid.txz</URL>
<MD5>2c641b1cbc7752578cc770bcb5117112</MD5>
</FILE>

<FILE Name="&emhttp;/README.md" Mode="0644">
<INLINE>
**nwipe (Secure Disk Eraser) with Preclear**

Terminal Command (to start the GUI): **nwipe** / User Manual: **nwipe -h**
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "*************************************************************"
echo "!! To start the GUI, type 'nwipe' into any terminal session."
echo "!! Best use TMUX or SCREEN to ENSURE the SESSION STAYS OPEN."
echo "!! Maintainer recommends Tmux Terminal Manager (TTM) plugin."
echo "*************************************************************"
echo ""
echo "-------------------------------------------------------------"
echo " nwipe (Secure Disk Eraser) with Preclear was installed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo "-------------------------------------------------------------"
echo ""
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
killall nwipe-bin >/dev/null 2>&amp;1

# part of the OS in some Unraid versions
rm -f &plgPATH;/parted*.txz

removepkg &plgPATH;/*.txz

rm -rf &plgPATH;
rm -rf &emhttp;

echo ""
echo "-----------------------------------------------------------"
echo " nwipe (Secure Disk Eraser) with Preclear was removed."
echo " Version: &version; / Plugin Maintainer: &author;"
echo "-----------------------------------------------------------"
echo ""
</INLINE>
</FILE>

</PLUGIN>
